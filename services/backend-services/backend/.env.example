APP_ENV=dev

# Required — no insecure default. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=1440

# Postgres for dev/prod (docker-compose); tests use an isolated in-memory
# SQLite DB regardless of this value — see tests/conftest.py.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dics_db

REDIS_URL=redis://localhost:6379/0

# MUST exactly match the frontend's wallet-signing message construction,
# character for character.
LOGIN_MESSAGE_PREFIX=Aurelia Labs login nonce:

# --- Oracle service ---
ORACLE_SERVICE_URL=http://localhost:4100
# MUST match ORACLE_SERVICE_API_KEY in oracle-service/.env exactly —
# a mismatch surfaces as a 502 with a clear message from this backend
# (see oracle_client.py), not a silent failure.
ORACLE_SERVICE_API_KEY=
ORACLE_SERVICE_TIMEOUT_SECONDS=10

# --- Indexer webhook (inbound) ---
# MUST match BACKEND_WEBHOOK_API_KEY in indexer/.env exactly.
INDEXER_WEBHOOK_API_KEY=

# --- Read-only chain connection (NEW) ---
# Points at the same InsurancePolicy PROXY address the frontend uses
# (VITE_INSURANCE_POLICY_ADDRESS in frontend/.env.example) — same
# contract, two independent clients reading it, one from a browser
# wallet, one from this backend.
RPC_URL=http://localhost:8545
INSURANCE_POLICY_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_ID=1337
