{
  "name": "dics-oracle-service",
  "version": "0.1.0",
  "description": "Off-chain oracle service that signs and relays OracleResponse attestations to OracleAdapter.sol. Plain JavaScript, no TypeScript, per project policy.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathIgnorePatterns=oracle.integration.test.js",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest oracle.integration.test.js",
    "test:all": "node --experimental-vm-modules node_modules/.bin/jest",
    "lint": "eslint src test --max-warnings=0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
