# Root docker-compose environment. Fill in the ADDRESS values AFTER
# deploying contracts (see besu-network/README.md) — everything else has
# a working local-dev default.
#
# SECURITY: every "insecure dev default" below is exactly that — fine
# for a laptop, not for anything shared. See each service's own README
# for the production-appropriate replacement (Vault/KMS for keys,
# a secrets manager for API keys, etc.).

# --- Shared Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dics_db

# --- Chain connection ---
# Point at whatever chain is actually running — the local Besu network
# (besu-network/docker-compose.yml, port 8545) or a standalone Anvil
# instance. This compose stack does NOT start the chain itself; start it
# separately first. See root README "run order".
#
# host.docker.internal lets containers on THIS compose stack reach a
# chain running on the host machine (outside this compose network) —
# works on Docker Desktop (Mac/Windows) out of the box; on Linux you may
# need --add-host=host.docker.internal:host-gateway (already added below).
CHAIN_RPC_URL=http://host.docker.internal:8545
CHAIN_ID=1337

# --- Deployed contract addresses (fill in after deployment) ---
CLAIM_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
INSURANCE_POLICY_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
STABLECOIN_ADDRESS=0x0000000000000000000000000000000000000000
CLAIM_REGISTRY_DEPLOY_BLOCK=0
INSURANCE_POLICY_DEPLOY_BLOCK=0

# --- Shared service-to-service secrets ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_SECRET_KEY=dev-only-change-me-0000000000000000000000000000000000000000
ORACLE_SERVICE_API_KEY=dev-only-oracle-key-0000000000000000000000000000000000
INDEXER_WEBHOOK_API_KEY=dev-only-indexer-key-000000000000000000000000000000

# --- Oracle signer (LOCAL DEV ONLY — see oracle-service/README.md) ---
# Anvil's well-known default-mnemonic account #0/#1. Rather than
# hardcoding hex values here (the exact mistake this project's own
# integration tests deliberately avoid — see the mnemonic-derivation
# comment in oracle-service/test/oracle.integration.test.js), derive
# them yourself with:
#
#   node -e "const {ethers}=require('ethers'); \
#     const m='test test test test test test test test test test test junk'; \
#     console.log('signer :', ethers.HDNodeWallet.fromPhrase(m,undefined,\"m/44'/60'/0'/0/0\").privateKey); \
#     console.log('relayer:', ethers.HDNodeWallet.fromPhrase(m,undefined,\"m/44'/60'/0'/0/1\").privateKey);"
#
# (run from within oracle-service/ where ethers is installed) and paste
# the results below. This address MUST be granted ORACLE_SIGNER_ROLE on
# the deployed OracleAdapter — see besu-network/README.md's role-wiring
# section.
ORACLE_SIGNER_PRIVATE_KEY=
ORACLE_RELAYER_PRIVATE_KEY=

# --- Underwriter ---
# UNDERWRITER_ROLE now belongs to a real Safe multisig, not a single
# EOA — see safe-ops/ and docs/services/10-Safe-Multisig-And-KMS.md.
# UNDERWRITER_PRIVATE_KEY below is kept ONLY for a fresh local/test
# deployment that never runs the Safe migration at all (granting
# UNDERWRITER_ROLE directly to this EOA instead of to a Safe) — on any
# deployment where the Safe migration HAS run, this key's calls will
# revert with AccessControlUnauthorizedAccount, not work with reduced
# security. Real day-to-day approve/reject/payout now happens via
# safe-ops/scripts/04-propose-and-execute-transaction.js.
UNDERWRITER_PRIVATE_KEY=

# --- safe-ops (Safe multisig + AWS KMS) ---
# Mirrored here (not just in safe-ops/.env.example) because
# docker-compose.yml's safe-ops service reads these from THIS file, not
# from safe-ops/.env.example — compose only substitutes ${VAR} from the
# root .env unless an env_file is separately configured, which this
# project doesn't do here. Running safe-ops' scripts directly (without
# Docker) can use either this file or safe-ops/.env.example — whichever
# is actually loaded is what matters, not which file has the "real" copy.
#
# Filled in by safe-ops/scripts/01-deploy-safe-infrastructure.js's own
# printed output — NOT the canonical mainnet Safe addresses, since this
# is a fresh deployment onto a private chain (see that script's header).
SAFE_SINGLETON_ADDRESS=
SAFE_PROXY_FACTORY_ADDRESS=
SAFE_FALLBACK_HANDLER_ADDRESS=
# Filled in by safe-ops/scripts/02-create-underwriter-safe.js's own
# printed output.
UNDERWRITER_SAFE_ADDRESS=
# A funded LOCAL/TEST key used ONLY to pay gas for the one-time Safe
# infrastructure deployment and Safe creation steps — never added as a
# Safe owner, never used for any claim-approval action.
DEPLOYER_PRIVATE_KEY=
# One AWS KMS key ID per employee-owner, comma-separated — see
# docs/services/10-Safe-Multisig-And-KMS.md's onboarding checklist for
# how each is provisioned (KeySpec ECC_SECG_P256K1).
AWS_REGION=us-east-1
OWNER_KMS_KEY_IDS=
SAFE_THRESHOLD=2
# Only needed if not running inside AWS with an attached IAM role — see
# safe-ops/.env.example's note on the AWS SDK's default credential
# chain. Never a long-lived credential pair in any committed file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Notification service ---
# Any endpoint accepting a JSON POST — a Slack incoming webhook URL, or
# a simple local test HTTP server while developing.
NOTIFICATION_WEBHOOK_URL=http://host.docker.internal:9000/webhook
NOTIFICATION_POLL_INTERVAL_SECONDS=300
NOTIFICATION_WARNING_WINDOW_DAYS=3
