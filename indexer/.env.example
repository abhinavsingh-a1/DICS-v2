RPC_URL=http://localhost:8545
CHAIN_ID=1337

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dics_db

CLAIM_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
INSURANCE_POLICY_ADDRESS=0x0000000000000000000000000000000000000000

# The block each contract was actually deployed in — avoids scanning
# from genesis unnecessarily on a long-lived chain. 0 is fine for a
# freshly-started local Anvil/Besu network.
CLAIM_REGISTRY_DEPLOY_BLOCK=0
INSURANCE_POLICY_DEPLOY_BLOCK=0

POLL_INTERVAL_MS=3000
BLOCK_RANGE_CHUNK_SIZE=2000
REORG_SAFETY_BLOCKS=2

# Optional — if unset, the indexer runs standalone with no backend
# notification (a warning is logged once). Both must be set together.
BACKEND_URL=http://localhost:8000
BACKEND_WEBHOOK_API_KEY=
