# RPC endpoint of the target network (local Besu, shared Besu, or Anvil)
RPC_URL=http://localhost:8545

# Chain ID must match the network's actual chain ID — the EIP-712 domain
# separator is bound to this, so a mismatch here silently produces
# signatures that verify against the WRONG chain, not an error.
CHAIN_ID=1337

# Deployed OracleAdapter proxy address (not the implementation address)
ORACLE_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000

# --- Signer key ---
# LOCAL/DEV ONLY. This is exactly the pattern the project's own
# architecture decisions say NOT to use in production — see
# src/signer.js and the README for why, and what to load instead
# (HashiCorp Vault or AWS KMS).
ORACLE_SIGNER_PRIVATE_KEY=0xYOUR_LOCAL_DEV_KEY_ONLY

# Optional: a separate key that only pays gas to relay the already-signed
# transaction. Submission is permissionless (see OracleAdapter.sol), so
# this key needs no privileged role — only ETH/gas token to spend.
# Defaults to ORACLE_SIGNER_PRIVATE_KEY if unset (not recommended beyond
# local dev — see README on why separating these two keys matters).
RELAYER_PRIVATE_KEY=

# HTTP port for this service's own API (called by the backend, not by
# end users directly)
PORT=4100

# Domain values — MUST exactly match what OracleAdapter.sol's
# __EIP712_init(name, version) call used, or every signature will fail
# on-chain recovery with no obvious error pointing at this mismatch.
EIP712_DOMAIN_NAME=DICS-OracleAdapter
EIP712_DOMAIN_VERSION=1

# --- Service-to-service auth ---
# Required header on POST /verify: X-Oracle-Service-Key: <this value>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PRODUCTION: load from a secrets manager (Vault/AWS Secrets Manager)
# with rotation, not a static .env value — same caveat as the signer
# private key above.
ORACLE_SERVICE_API_KEY=
