<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DicsV2.DocumentService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <!--
      Nethereum is the standard .NET Ethereum library — the direct
      analogue of web3j (Java, used in underwriter-service) and
      go-ethereum (Go, used in notification-service). Used here
      specifically for Nethereum.Util.Sha3Keccack — a REAL Keccak256
      implementation, not .NET's built-in SHA3 (System.Security.Cryptography
      implements the NIST-standardized SHA-3, which uses different padding
      and produces DIFFERENT hashes than Ethereum's Keccak256, despite the
      similar name — a well-known gotcha worth naming directly rather than
      silently getting wrong). Using the real Keccak256 here means the
      Merkle root this service computes would actually match what a
      Solidity contract computes, if on-chain verification is ever added
      — see MerkleTreeService.cs's header on what is and isn't built yet.
    -->
    <PackageReference Include="Nethereum.Util" Version="4.24.1" />
  </ItemGroup>

</Project>
